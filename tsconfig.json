{
  "extends": "@gravity-ui/tsconfig/tsconfig",
  "compilerOptions": {
    "rootDir": "./src",
    "target": "es2022",
    "useDefineForClassFields": false,
    "outDir": "dist",
    "declaration": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node", "jest"]
  },
  "include": ["src/**/*.ts"],
  "excludeDirectories": ["**/node_modules", "dist"]
}
